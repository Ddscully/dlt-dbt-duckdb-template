# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# coverage.py's data file: `just coverage` always leaves it (written by
# `coverage run`, read by `coverage report`).
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv
.uv/

# Data warehouse & downloaded sources (regenerated by the pipeline)
data/*.duckdb
data/*.duckdb.wal
data/raw/
# Anything a source script downloads and the pipeline re-reads. The seeds and
# fixtures built *from* such a file are checked in; the file itself is not.
data/*.xlsx
# Copies of what a URL served, kept between runs so a partitioned or repeated
# load does not re-fetch. Safe to delete.
data/cache/
*.csv
!dbt/seeds/*.csv
# Unit-test fixtures are source, like the seeds. Without this line `dbt test`
# passes locally against files git never took, and CI fails.
!dbt/tests/fixtures/*.csv
# Ingest fixtures are source too, for the same reason: `just test-pipeline`
# passes locally against a CSV git never took, and CI fails.
!tests/fixtures/ingest/*.csv

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
# A lock dbt does not always remove after `dbt deps`.
dbt/package-lock.concurrent-update-lock

# dlt
.dlt/secrets.toml
**/.dlt/pipelines/

# Dagster instance: run/event storage, compute logs (DAGSTER_HOME).
# The checked-in dagster.yaml is config; everything beside it is state.
.dagster/*
!.dagster/dagster.yaml
.tmp_dagster_home_*/

# Evidence
reports/.evidence/
reports/build/
node_modules/

# Agent session transcripts and scratch notes: a local working record, never
# committed. What should outlive a session belongs in AGENTS.md or a skill.
docs/sessions/

# The DuckLake landing zone, filled by `just ingest`. It is **the only copy of
# every landing table**, so `just clean` skips it: re-making it costs whatever
# the sources charge to fetch again, which for a rate-limited or paid API is the
# whole archive.
data/lakehouse/
